generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  QUEUED
  PLAYED
  DELETED
}

enum PaymentStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model SongDatabase {
  id         String      @id @default(cuid())
  name       String
  songs      Song[]
  requests   Request[]
  searchLogs SearchLog[]
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
}

// Trigram GIN indexes on name/artist are added via a hand-written migration
// (prisma/migrations/.../migration.sql) since Prisma 7 no longer supports
// declaring Postgres extensions or typed index kinds in the schema itself.
// See README.md "Database notes" for why, and the caution about future
// `prisma migrate dev` diffs.
model Song {
  id             String       @id @default(cuid())
  songDatabaseId String
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id], onDelete: Cascade)
  name           String
  artist         String
  decade         String?
  genres         String[]     @default([])
  requests       Request[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([songDatabaseId])
  @@index([songDatabaseId, artist])
  @@index([songDatabaseId, decade])
}

// The partial index that keeps Live Queue reads fast regardless of history
// size (`CREATE INDEX ... ON "Request" (...) WHERE status = 'QUEUED'`) is
// also added via the hand-written migration — Prisma has no `@@index` syntax
// for a WHERE clause.
model Request {
  id             String       @id @default(cuid())
  songDatabaseId String
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id])
  songId         String?
  song           Song?        @relation(fields: [songId], references: [id], onDelete: SetNull)

  // Snapshot at request time so history survives later song edits/CSV replace
  songName   String
  artistName String
  decade     String?

  requesterName String
  wantsShoutOut Boolean @default(false)
  billingName   String?

  status      RequestStatus @default(QUEUED)
  requestedAt DateTime      @default(now()) @db.Timestamptz(3)
  playedAt    DateTime?     @db.Timestamptz(3)
  deletedAt   DateTime?     @db.Timestamptz(3)

  tipAmountCents        Int           @default(0)
  // Legacy Stripe-era payments — historical/audit only, no code path writes
  // these going forward. Kept alongside the Square fields rather than
  // renamed/dropped so old records stay queryable.
  stripePaymentIntentId String?       @unique
  stripeFeeCents        Int?
  squarePaymentId       String?       @unique
  squareFeeCents        Int?
  paymentStatus         PaymentStatus @default(NONE)
  refundedAmountCents   Int           @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([songDatabaseId, status])
  @@index([status, songDatabaseId, requestedAt])
}

model SearchLog {
  id             String       @id @default(cuid())
  songDatabaseId String
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id])
  searchTerm     String
  resultsFound   Boolean
  eventType      String // 'debounce' | 'submit' | 'select'
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([songDatabaseId, createdAt])
  @@index([searchTerm])
}

model Settings {
  id                     Int      @id @default(1) // singleton row, app enforces id=1
  activeSongDatabaseId   String?
  bio                    String?
  photoUrl               String?
  logoUrl                String?
  instagramUrl           String?
  facebookUrl            String?
  tiktokUrl              String?
  youtubeUrl             String?
  spotifyUrl             String?
  websiteUrl             String?
  contactEmail           String?
  defaultTipAmountsCents Int[]    @default([500, 1000, 2000])
  brandPrimaryColor      String?
  brandSecondaryColor    String?
  disableRecentlyPlayedPrompt Boolean @default(false)
  // Public "share this calendar" links (webcal:// → https://) from iCloud
  // (or any RFC 5545) calendars — e.g. a general gigs calendar plus a
  // separate weekly-residency calendar. /gigs merges every URL here into
  // one sorted list, no dashboard CRUD needed since Lochie already manages
  // his gig dates in Calendar.
  gigsCalendarUrls        String[] @default([])
  // Phrases stripped out of gig titles before display on /gigs — needed
  // because a shared calendar Lochie doesn't own (e.g. a venue's recurring
  // residency listing) can't be renamed at the source.
  gigTitleFilters         String[] @default([])
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

// Public /book form submissions — reviewed and actioned manually from the
// dashboard, same "no queue automation, artist handles it by hand" pattern
// as request moderation elsewhere in this app.
model BookingInquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  // Free text, not DateTime — this is informational only (never used in a
  // calculation/sort where a timezone bug could bite, per the DateTime
  // pitfall already hit and fixed elsewhere in this schema).
  eventDate String?
  location  String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}
