generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  QUEUED
  PLAYED
  DELETED
}

enum PaymentStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// One per person who performs with this app (Lochie, Mitchell, ...). Every
// catalog/config table below is owned by exactly one performer, and the
// dashboard only ever reads or writes the logged-in performer's own rows
// (see src/lib/auth.ts). Request and SearchLog aren't owned directly — they
// belong to a SongDatabase, which is. authUserId is the Supabase Auth user
// id (the JWT "sub" claim); a login with no Performer row gets no dashboard
// access at all. Linked/created via prisma/performers.ts.
model Performer {
  id                 String                   @id @default(cuid())
  authUserId         String?                  @unique
  // Public URL segment for this performer's pages (phase 2).
  slug               String                   @unique
  name               String
  songDatabases      SongDatabase[]
  venues             Venue[]
  songPairingMembers SongPairingGroupMember[]
  songKeys           SongKey[]
  forScorePrograms   ForScoreProgram[]
  forScoreLinks      ForScoreLink[]
  devices            PerformerDevice[]
  deviceCommands     DeviceCommand[]
  bookingInquiries   BookingInquiry[]
  settings           Settings?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
}

model SongDatabase {
  id          String      @id @default(cuid())
  performerId String
  performer   Performer   @relation(fields: [performerId], references: [id])
  name        String
  songs       Song[]
  requests    Request[]
  searchLogs  SearchLog[]
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@index([performerId])
}

// Trigram GIN indexes on name/artist are added via a hand-written migration
// (prisma/migrations/.../migration.sql) since Prisma 7 no longer supports
// declaring Postgres extensions or typed index kinds in the schema itself.
// See README.md "Database notes" for why, and the caution about future
// `prisma migrate dev` diffs.
model Song {
  id             String       @id @default(cuid())
  songDatabaseId String
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id], onDelete: Cascade)
  name           String
  artist         String
  decade         String?
  genres         String[]     @default([])
  requests       Request[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([songDatabaseId])
  @@index([songDatabaseId, artist])
  @@index([songDatabaseId, decade])
}

// A DJ-defined group of songs that all transition into each other with no
// break (e.g. a mashup set) — requesting any one auto-queues every other
// member as a linked song, without a real audience request existing for
// them. Membership rows share a `groupId` (no separate parent-group table;
// the id is just a shared grouping key generated when a group is created —
// deleting a group means deleting every row with that id). Owned by one
// performer, and within that performer global by song name+artist rather
// than scoped to one SongDatabase/Song row — the same
// physical song is catalogued as a separate Song row in every database
// that includes it (e.g. a "Guitar" set list and an "All Songs" superset),
// and a group should apply in all of them. Also means groups survive a CSV
// replace (importSongsCsv deletes+recreates every Song row), unlike
// anything keyed to a Song id would. Applied in src/actions/requests.ts
// when a real request is created — matched by the triggering request's
// snapshot songName/artistName against every group it's a member of, then
// each *other* member resolved against a Song row in that same request's
// own database (skipped if that member isn't in the database's catalog).
// Each resulting auto-added Request row is linked back to the request that
// triggered it via Request.triggeredByRequestId, and flagged
// Request.isPairedAddition so it never counts in Statistics.
model SongPairingGroupMember {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id])
  groupId     String
  songName    String
  artistName  String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([groupId, songName, artistName])
  @@index([groupId])
  @@index([performerId, songName, artistName])
}

// Different gigs call for different hype songs, so bangers are scoped per
// Venue rather than global. The Live Queue's venue selector sets
// Settings.currentVenueId, and Banger Mode (toggled with the B key) reads
// bangers for whichever venue is currently selected there.
model Venue {
  id          String       @id @default(cuid())
  performerId String
  performer   Performer    @relation(fields: [performerId], references: [id])
  name        String
  bangers     BangerSong[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([performerId])
}

// A DJ-curated "hype" list, scoped to one Venue. Purely a dashboard lens:
// Live Queue's "banger mode" filters the *existing* queue down to tipped
// requests plus shout-out requests whose song is on the current venue's
// list — it never restricts what the audience can request or changes what
// gets queued, so unlike SongPairingGroupMember it has nothing to do with
// src/actions/requests.ts.
model BangerSong {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  songName   String
  artistName String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([venueId, songName, artistName])
  @@index([venueId])
}

// The recording's key, and the key Lochie actually performs it in when
// they differ (e.g. transposed down for his vocal range). Per performer,
// and within that performer global by song name+artist rather than a
// column on Song — same reasoning as
// SongPairingGroupMember/BangerSong: a song's key doesn't depend on which
// database's set list it's catalogued in, so filling it in once should
// apply everywhere that song appears, and it survives a CSV replace
// (importSongsCsv deletes+recreates every Song row for a database).
// Purely catalog/reference metadata — deliberately not read by song
// pairing matching (src/actions/requests.ts), since he may transpose
// further on the night depending on how his voice is doing, and a pairing
// shouldn't silently break over that.
model SongKey {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id])
  songName    String
  artistName  String
  originalKey String?
  lochiesKey  String?
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([performerId, songName, artistName])
}

// The MIDI Program Change that opens this song's score in a forScore
// library: each score there has a MIDI "Open" command of Program Change
// <program> on channel 1 (forScore stores it as raw hex, e.g. "C0 32" =
// program 50), so sending that message opens the chart. Per performer
// (each player's iPad library is numbered independently), and within that
// performer global by song name+artist, same reasoning as SongKey.
model ForScoreProgram {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id])
  songName    String
  artistName  String
  program     Int
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([performerId, songName, artistName])
  @@unique([performerId, program])
}

// Which forScore score a song opens via forScore's URL scheme
// (forscore://open?score=<title> — see src/lib/liveControl/forscoreUrl.ts),
// the MIDI-free alternative to ForScoreProgram. The app's song title often
// differs from the score's title in forScore, so this is an explicit,
// editable mapping (dashboard/forscore). Per performer, global by song
// name+artist, same reasoning as SongKey. filename, if set, is preferred by
// forScore over title; setlist narrows the lookup to one setlist.
model ForScoreLink {
  id          String    @id @default(cuid())
  performerId String
  performer   Performer @relation(fields: [performerId], references: [id])
  songName    String
  artistName  String
  title       String?
  filename    String?
  setlist     String?
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([performerId, songName, artistName])
}

// A browser (or, later, a native app) signed in as a performer that takes
// part in live control — e.g. an iPhone "controller" and an iPad
// "forscore_receiver". The id is kept in the device's localStorage.
// channelToken is the secret Realtime Broadcast topic the receiver listens
// on: only the server (which checks ownership before sending) and that
// device ever learn it, so knowing a device id isn't enough to reach it.
// lastSeenAt is bumped by the receiver's heartbeat while its Realtime
// subscription is up — the controller's online/offline indicator.
model PerformerDevice {
  id           String          @id @default(cuid())
  performerId  String
  performer    Performer       @relation(fields: [performerId], references: [id])
  name         String
  role         String // 'controller' | 'forscore_receiver'
  channelToken String          @unique
  lastSeenAt   DateTime?       @db.Timestamptz(3)
  commands     DeviceCommand[]
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([performerId, role])
}

// One live-control command sent to a device (id = the event's eventId).
// Doubles as the debugging log, lets the controller see whether the
// receiver acknowledged it (deliveredAt), and lets a receiver that briefly
// lost its connection pick up a very recent command it missed. type is
// generic ("forscore.open_score" today — see src/lib/liveControl/events.ts).
model DeviceCommand {
  id             String          @id @default(cuid())
  performerId    String
  performer      Performer       @relation(fields: [performerId], references: [id])
  targetDeviceId String
  targetDevice   PerformerDevice @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)
  sourceDeviceId String?
  type           String
  payload        Json
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  deliveredAt    DateTime?       @db.Timestamptz(3)

  @@index([targetDeviceId, createdAt])
}

// The partial index that keeps Live Queue reads fast regardless of history
// size (`CREATE INDEX ... ON "Request" (...) WHERE status = 'QUEUED'`) is
// also added via the hand-written migration — Prisma has no `@@index` syntax
// for a WHERE clause.
model Request {
  id             String       @id @default(cuid())
  songDatabaseId String
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id])
  songId         String?
  song           Song?        @relation(fields: [songId], references: [id], onDelete: SetNull)

  // Snapshot at request time so history survives later song edits/CSV replace
  songName   String
  artistName String
  decade     String?

  requesterName String
  wantsShoutOut Boolean @default(false)
  billingName   String?

  status      RequestStatus @default(QUEUED)
  requestedAt DateTime      @default(now()) @db.Timestamptz(3)
  playedAt    DateTime?     @db.Timestamptz(3)
  deletedAt   DateTime?     @db.Timestamptz(3)

  // Auto-added via a SongPairing rule rather than a real audience/DJ
  // request — excluded from every Statistics query (src/lib/statistics.ts)
  // regardless of status, since nobody actually requested it. Resolves
  // (PLAYED/DELETED) in lockstep with triggeredByRequest: the Live Queue
  // only ever acts on the pair as a unit, never on this row alone.
  isPairedAddition     Boolean   @default(false)
  triggeredByRequestId String?
  triggeredByRequest   Request?  @relation("PairingTrigger", fields: [triggeredByRequestId], references: [id], onDelete: Cascade)
  triggeredPairings    Request[] @relation("PairingTrigger")

  // Auto-added when Banger Mode is switched on (see LiveQueueList's B
  // shortcut / src/actions/bangers.ts activateBangerMode) — a real queue
  // entry with normal PLAY/DELETE, but not a real audience request, so
  // it's excluded from Statistics/the recently-played prompt exactly like
  // isPairedAddition, and never shown on the public /queue page (see
  // getPublicQueue's filter in src/lib/queue.ts). Unlike isPairedAddition
  // it isn't folded under any trigger — it stands as its own card, since
  // there's no single "request" that caused it.
  isBangerAddition Boolean @default(false)

  tipAmountCents        Int           @default(0)
  // Legacy Stripe-era payments — historical/audit only, no code path writes
  // these going forward. Kept alongside the Square fields rather than
  // renamed/dropped so old records stay queryable.
  stripePaymentIntentId String?       @unique
  stripeFeeCents        Int?
  squarePaymentId       String?       @unique
  squareFeeCents        Int?
  paymentStatus         PaymentStatus @default(NONE)
  refundedAmountCents   Int           @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([songDatabaseId, status])
  @@index([status, songDatabaseId, requestedAt])
  @@index([triggeredByRequestId])
}

model SearchLog {
  id             String       @id @default(cuid())
  songDatabaseId String
  // Cascades (unlike Request's deliberate RESTRICT) — search logs are
  // disposable analytics, not an audit trail, and this RESTRICT was
  // silently blocking Song Databases > Delete with no readable reason (the
  // thrown FK error hit Next's production Server Action redaction and
  // surfaced only as "Minified React error #441").
  songDatabase   SongDatabase @relation(fields: [songDatabaseId], references: [id], onDelete: Cascade)
  searchTerm     String
  resultsFound   Boolean
  eventType      String // 'debounce' | 'submit' | 'select'
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([songDatabaseId, createdAt])
  @@index([searchTerm])
}

model Settings {
  id                          Int       @id @default(autoincrement())
  // One row per performer (Lochie's is the original id=1 singleton).
  performerId                 String    @unique
  performer                   Performer @relation(fields: [performerId], references: [id])
  activeSongDatabaseId        String?
  // Which Venue's Bangers list Banger Mode reads on the Live Queue — plain
  // string, no relation, same convention as activeSongDatabaseId (deleting
  // the venue just leaves this pointing at nothing, harmlessly).
  currentVenueId              String?
  // Which PerformerDevice (a forScore receiver — an iPad/iPhone running
  // the Shortcut) the forScore button sends to, from every controller. Plain
  // string like currentVenueId; a deleted device just falls back to "the
  // only receiver", if there's exactly one.
  forScoreReceiverId          String?
  bio                         String?
  photoUrl                    String?
  logoUrl                     String?
  instagramUrl                String?
  facebookUrl                 String?
  tiktokUrl                   String?
  youtubeUrl                  String?
  spotifyUrl                  String?
  websiteUrl                  String?
  contactEmail                String?
  defaultTipAmountsCents      Int[]     @default([500, 1000, 2000])
  brandPrimaryColor           String?
  brandSecondaryColor         String?
  disableRecentlyPlayedPrompt Boolean   @default(false)
  // Public "share this calendar" links (webcal:// → https://) from iCloud
  // (or any RFC 5545) calendars — e.g. a general gigs calendar plus a
  // separate weekly-residency calendar. /gigs merges every URL here into
  // one sorted list, no dashboard CRUD needed since Lochie already manages
  // his gig dates in Calendar.
  gigsCalendarUrls            String[]  @default([])
  updatedAt                   DateTime  @updatedAt @db.Timestamptz(3)
}

// Public /book form submissions — reviewed and actioned manually from the
// dashboard, same "no queue automation, artist handles it by hand" pattern
// as request moderation elsewhere in this app.
model BookingInquiry {
  id          String        @id @default(cuid())
  performerId String
  performer   Performer     @relation(fields: [performerId], references: [id])
  name        String
  email       String
  phone       String?
  // Free text, not DateTime — this is informational only (never used in a
  // calculation/sort where a timezone bug could bite, per the DateTime
  // pitfall already hit and fixed elsewhere in this schema).
  eventDate   String?
  location    String?
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@index([performerId, status, createdAt])
}
