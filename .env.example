# Local dev (Postgres running via Homebrew, no pooling needed):
DATABASE_URL="postgresql://localhost:5432/song_request_dev"
DIRECT_URL="postgresql://localhost:5432/song_request_dev"

# Permanent public URL the QR code points to (the whole point of the QR code
# is that it never changes — update this once, on deploy, and never again).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production (Supabase): DATABASE_URL = pooled connection (port 6543, pgbouncer),
# DIRECT_URL = direct connection (port 5432). Runtime app code uses DATABASE_URL;
# `prisma migrate`/`generate` use DIRECT_URL via prisma.config.ts.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres"

# Square (migrated from Stripe — see DEPLOYMENT.md)
# SQUARE_ACCESS_TOKEN=""
# SQUARE_ENVIRONMENT="sandbox"                  # "sandbox" | "production"
# SQUARE_WEBHOOK_SIGNATURE_KEY=""
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
# NEXT_PUBLIC_SQUARE_LOCATION_ID=""
# NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"       # client needs its own copy to pick the right CDN script

# Supabase (Phase 1 realtime broadcast / later Auth+Storage)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
